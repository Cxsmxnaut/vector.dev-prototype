{
  "name": "vector-dev",
  "productName": "vector.dev",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server/main.mjs",
    "open": "node scripts/open-browser.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "package:mac": "npm run build && electron-packager . 'vector.dev' --app-bundle-id=dev.vector.desktop --platform=darwin --arch=arm64 --icon=assets/Vector.icns --out=release --overwrite --ignore='^/(protocol|test|release|.runtime|src|evidence|.git)(/|$)'",
    "release:mac": "npm run package:mac && node scripts/package-release.mjs",
    "test": "node --test test/*.test.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "protocol:update": "node scripts/update-protocol.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.3.0",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "description": "A local desktop and browser workspace for Codex.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cxsmxnaut/vector.dev.git"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
